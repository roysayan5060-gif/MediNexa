PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Hosted)
# Set your real connection string securely in your local .env or Render Dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medinexa?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway Credentials (Test/Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Allowed frontend origin for CORS
FRONTEND_URL=*
