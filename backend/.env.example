# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas connection string here:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctor-x?retryWrites=true&w=majority
# If left blank or unset in development, an embedded in-memory MongoDB will be used automatically for seamless local testing.
MONGODB_URI=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_doctor_x_healthcare_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Razorpay Payment Gateway Configuration
# Mode: 'test' for sandbox testing, 'live' for production
PAYMENT_MODE=test

# Razorpay API Credentials (From Razorpay Dashboard > Settings > API Keys)
# Keep RAZORPAY_KEY_SECRET strictly on the server; NEVER expose in frontend or Git!
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Secret (From Razorpay Dashboard > Settings > Webhooks)
# Set Webhook URL to: https://<your-backend-domain>/api/payments/webhook
# Secret is used to cryptographically verify X-Razorpay-Signature header
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
